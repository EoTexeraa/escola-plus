# Porta HTTP
PORT=3000
# Banco: arquivo local (desenvolvimento) ou Turso (produção: libsql://<db>-<org>.turso.io)
DATABASE_URL=file:../data/escola.db
DATABASE_AUTH_TOKEN=
# Segredo para assinar sessões (mínimo 32 caracteres). Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=
# Origens extras permitidas (separadas por vírgula), ex.: http://localhost:5173
CORS_ORIGINS=http://localhost:5173
NODE_ENV=development
SCHOOL_TZ=America/Sao_Paulo
# Limite de requisições por IP a cada 15 min (padrão 600)
API_RATE_LIMIT=600
